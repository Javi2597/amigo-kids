# ===== Proveedor de IA (endpoint OpenAI-compatible) =====
# Por defecto usamos Groq (gratis, sin tarjeta). Cambia base URL + key para
# usar Mistral, NVIDIA NIM, OpenRouter, etc. SIN tocar el codigo.

# Tu clave (sin comillas). Obtenla en https://console.groq.com -> API Keys
AI_API_KEY=

# Base URL por proveedor:
# Grq               https://api.groq.com/openai/v1
# NVIDIA NIM        https://integrate.api.nvidia.com/v1
# OpenRouter        https://openrouter.ai/api/v1
# Mistral           https://api.mistral.ai/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Modelo de chat (Groq): llama-3.3-70b-versatile | mistral: mistral-small-latest
AI_MODEL=llama-3.3-70b-versatile

# ===== Visión de fotos (Groq, multimodal) =====
AI_VISION_MODEL=qwen/qwen3.6-27b

# ===== Auditoría de imágenes local (opcional, no se usa en producción) =====
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# ===== Proveedor de respaldo (fallback) cuando Groq llega a su límite =====
# Solo se usa para CHAT de texto; las fotos nunca salen de Groq.
# Recomendado: Gemini (Google AI Studio), gratis sin tarjeta:
#   https://aistudio.google.com -> API keys -> crear clave
FALLBACK_AI_API_KEY=
FALLBACK_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_AI_MODEL=gemini-3.1-flash-lite